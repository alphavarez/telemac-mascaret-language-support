/
NOM = 'DISTANCE MINIMALE A LA FRONTIERE'
NOM1 = 'MINIMUM DISTANCE AT BOUNDARY'
TYPE = REAL
INDEX = 34
TAILLE = 1
DEFAUT1 = 0.
RUBRIQUE = 'TREATMENT';'BOTTOM';''
RUBRIQUE1 = 'TREATMENT';'BOTTOM';''
NIVEAU = 1
AIDE1 = 'The bathymetric data at the mesh nodes are interpolated. At each mesh node, the plane is cut into 4 quadrants in each of which, among the points recorded at the digitizing tablet, the closest one to the node being considered is searched for. This node is thenn given a depth corresponding to the mean depth at each of the 4 points previously found, these depths being weighted by the distance to the node. When searching for the points in the quadrants, however, one shall make sure the boundaries aare not overstepped in order to prevent aberrations from being introduced into the bathymetric data. The keyword can then be used for specifying the minimum distance to the boundaries below which the recorded points should be ignored.'
/
NOM = 'DISTANCE MINIMALE ENTRE DEUX POINTS'
NOM1 = 'MINIMUM DISTANCE BETWEEN TWO POINTS'
TYPE = REAL
INDEX = 35
TAILLE = 1
MNEMO = 'EPSI'
DEFAUT1 = 1.E-5
RUBRIQUE = 'TREATMENT';'';''
RUBRIQUE1 = 'TREATMENT';'';''
NIVEAU = 1
AIDE1 = 'Distance (in meters) below which two nodes are considered as identical by STBTEL when the results supplied by the mesh generator are being checked. When two nodes occur at the same place, one of them is eliminated and all the mesh nodes are renumbered.'
/
NOM = 'RENUMEROTATION DES POINTS'
NOM1 = 'NODES RENUMBERING'
TYPE = LOGICAL
INDEX = 36
TAILLE = 1
MNEMO = 'OPTASS'
DEFAUT1 = NO
RUBRIQUE = 'TREATMENT';'';''
RUBRIQUE1 = 'TREATMENT';'';''
NIVEAU = 1
AIDE1 = 'Necessary to use the new storage scheme for the matrix.'
/
