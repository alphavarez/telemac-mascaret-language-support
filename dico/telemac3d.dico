NIVEAU = 1
AIDE1 = 'Gives the option for managing the wind: • 1: constant in time and space, given by the keywords WIND VELOCITY ALONG X and WIND VELOCITY ALONG Y, • 2: variable in time and constant in space, given by formatted file, • 3: variable in time and space, given by formatted file or by a binary file.'
/
