INDEX = 132
TAILLE = 1
MNEMO = 'HAUTIN'
DEFAUT1 = 0.
RUBRIQUE = 'HYDRODYNAMICS';'INITIALIZATION';''
RUBRIQUE1 = 'HYDRODYNAMICS';'INITIALIZATION';''
NIVEAU = 1
AIDE1 = 'Value to be used along with the option: INITIAL CONDITIONS : "CONSTANT DEPTH".'
/
NOM = 'COTE INITIALE'
